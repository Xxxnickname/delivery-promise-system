            "default": "ALL_OR_NOTHING"
          },
          "allow_partial": {
            "type": "boolean",
            "title": "Allow Partial",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "orders",
          "bom",
          "inventory",
          "in_transit"
        ],
        "title": "Body_upload_bundle_api_imports_bundle_post"
      },
      "BomExpandRequest": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "root_code": {
            "type": "string",
            "minLength": 1,
            "title": "Root Code"
          },
          "qty": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Qty"
          },
          "max_depth": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Max Depth",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "batch_id",
          "root_code",
          "qty"
        ],
        "title": "BomExpandRequest",
        "description": "BOM 展开请求；数量用 Decimal 接收，避免前端 float 进入计算层。"
      },
      "ExportRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Batch Id"
          },
          "from_snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Snapshot"
          },
          "to_snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Snapshot"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "ExportRequest",
        "description": "导出请求：齐套报告或快照差异。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
