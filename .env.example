APP_ENV=development
DATABASE_URL=sqlite:///./plan.db
AUTH_SECRET=change-me-32-bytes-minimum
ACCESS_TOKEN_MINUTES=60
# 应用端口：三项目并行，本项目固定 8003
APP_PORT=8003
DB_DSN=postgresql://plan:plan@postgres:5432/plan
REDIS_URL=redis://redis:6379/0
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
LLM_ENABLED=false
MODEL_TIMEOUT_SECONDS=20
MODEL_API_KEY=
MAX_UPLOAD_MB=20
MAX_BOM_DEPTH=5
EXPORT_MAX_ROWS=50000
POSTGRES_DB=plan
POSTGRES_USER=plan
POSTGRES_PASSWORD=plan
PRODUCTION_LEAD_DAYS=3




AUTH_REQUIRED=true



